{
  "name": "ai-proposals",
  "version": "1.0.0",
  "description": "Safe bridge and interactive approval hub for AI proposals in Obsidian",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "proposals",
    "codemirror"
  ],
  "author": "Mikołaj",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.3",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
